# llama.cpp's server program, from https://github.com/ggml-org/llama.cpp/releases
LLAMA_SERVER=C:\llama.cpp\llama-server.exe

# The folder with your GGUF models (default: models in this folder)
# MODELS_DIR=models

# Set both to use the chat from your other devices (home network and Tailscale)
APP_PASSWORD=
FLASK_SECRET_KEY=

# The instruction every chat starts with
# SYSTEM_PROMPT=You are a helpful assistant. Always reply in the language the user writes in.

# CONTEXT=16384
# REPLY_TOKENS=4096
# GPU_LAYERS=all
# THREADS=0
# CACHE_TYPE=q8_0
# TEMPERATURE=0.8
# WARM_SECONDS=600
# START_TIMEOUT=180
# LLAMA_ARGS=
